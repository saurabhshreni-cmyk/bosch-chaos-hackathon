GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_CALLS_PER_ANALYSIS=15
LLM_TEMPERATURE=0.1
PFIA_SAMPLE_INTERVAL=60
PFIA_RETENTION_DAYS=7
PFIA_MAX_SAMPLES=10000
# Runtime collection is opt-in. Set to the existing Compose project label.
PFIA_DOCKER_PROJECT=
PFIA_COLLECT_RUNTIME=false
PFIA_ENABLE_GROQ=false
PFIA_BACKEND_URL=http://127.0.0.1:8091
# Optional three-agent operations. Blank settings keep execution disabled.
PFIA_OPERATOR_TOKEN=
PFIA_POLICY_FILE=
